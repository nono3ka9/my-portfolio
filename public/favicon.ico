<svg width="300" height="150" xmlns="http://www.w3.org/2000/svg" style="background-color:white">
  <!-- グラデーション定義 -->
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#000000;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#555555;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="3" dy="3" stdDeviation="2" flood-color="rgba(0,0,0,0.5)" />
    </filter>
  </defs>

  <!-- 文字 -->
  <text x="50%" y="50%" text-anchor="middle" dominant-baseline="middle"
        font-family="Hiragino Mincho ProN, serif" font-size="96" fill="url(#grad1)"
        font-weight="bold" filter="url(#shadow)">
    NK
  </text>
</svg>